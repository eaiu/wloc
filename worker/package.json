{
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs test/*.test.js",
    "dev": "wrangler dev -c wrangler.worker.jsonc",
    "deploy": "wrangler deploy -c wrangler.worker.jsonc --minify",
    "build:check": "wrangler deploy -c wrangler.worker.jsonc --dry-run --outdir ../build/worker",
    "pages:build": "wrangler pages functions build functions --outdir ../build/pages",
    "pages:dev": "wrangler pages dev --port 8787",
    "pages:deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "name": "wloc-worker",
  "private": true,
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
